{
  "manifest_version": 3,
  "name": "玻璃主页",
  "version": "1.1.0",
  "description": "磨砂玻璃风格的新标签页：搜索、导航卡片与壁纸。",
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "permissions": ["storage", "favicon"],
  "host_permissions": [
    "https://www.bing.com/*",
    "https://cn.bing.com/*",
    "https://api.bing.com/*",
    "https://suggestqueries.google.com/*",
    "https://www.baidu.com/*",
    "https://duckduckgo.com/*",
    "https://sor.html5.qq.com/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
